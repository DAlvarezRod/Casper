# Claves y configuración (opcional). Copia este archivo como ".env" y pon tus valores ahí.
# NUNCA escribas una clave real en el código ni la subas a GitHub:
# .env ya está en .gitignore.
#
# NEWS_API_KEY: gratis en https://newsapi.org
#   Con ella, "noticias" muestra titulares generales de Colombia.
#   Sin ella, "noticias" usa Hacker News (tecnología, sin registro).
NEWS_API_KEY=
#
# Fase 6 — cerebro (modelo de lenguaje):
# CASPER_LLM: "ollama" (local, gratis, sin clave) o "gemini" (nube, gratis con clave).
CASPER_LLM=ollama
# OLLAMA_MODEL: modelo local. Requiere Ollama instalado y el modelo descargado:
#   ollama pull qwen2.5:3b
# Alternativas: llama3.2, mistral, qwen2.5:7b (más capaz, más pesado).
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL: donde corre Ollama (por defecto en tu propio computador).
OLLAMA_URL=http://localhost:11434
# GEMINI_API_KEY: gratis en https://aistudio.google.com/app/apikey
#   Solo se usa si CASPER_LLM=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
